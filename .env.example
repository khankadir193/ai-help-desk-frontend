# AI Help Desk Frontend Environment Variables
#
# Production build (npm run build). This value is baked in at build time, so
# also set it in the frontend hosting dashboard (Vercel/Netlify/Render static).
# The backend exposes its API under /api/v1. No trailing slash.
VITE_API_BASE_URL=https://ai-helpdesk-backend-w606.onrender.com/api/v1

# Local development is configured in .env.development:
# VITE_API_BASE_URL=http://localhost:3000/api/v1
